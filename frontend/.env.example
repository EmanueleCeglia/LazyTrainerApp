# Where the app should reach the FastAPI backend.
# Expo inlines any EXPO_PUBLIC_* variable at build time.
#
# Development (Expo Go): your computer LAN IP - find it with `ipconfig` / `ifconfig`
# Production (APK):      your public tunnel URL
#
# Copy this file to `.env` and set the value. Without it the app falls back to
# the defaults baked into src/api/client.ts.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
